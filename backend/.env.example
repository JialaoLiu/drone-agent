# 复制为 .env 并填入自己的密钥。.env 已被 .gitignore 排除，不会提交。
# 文字模型（调度员、规划员、报告员、诊断员），OpenAI 兼容接口，默认 DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 视觉模型（巡检员）：deepseek 或 openai
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-v4-flash-vision-exp
# 使用 OpenAI 看图时填写
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# 路径：PX4 源码目录、数据目录（照片、场景、数据库；建议放在空间充足的磁盘）
# 默认放在仓库旁边的 drone-agent-related 目录（px4/PX4-Autopilot、data），一般不需要填写
# PX4_DIR=
# DRONE_AGENT_DATA=

# 可选：访问令牌。设置后所有接口都要带令牌（网页首次访问时输入一次），局域网开放时建议设置。
DRONE_AGENT_ACCESS_TOKEN=
